<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="?attr/colorSurface">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Create Snippet Card"
        android:fontFamily="sans-serif-medium"
        android:textSize="18sp"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Share a highlighted quote or excerpt with beautiful citation"
        android:textSize="12sp"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <EditText
        android:id="@+id/editQuoteText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:minLines="2"
        android:maxLines="6"
        android:gravity="top|start"
        android:padding="12dp"
        android:textSize="13sp"
        android:hint="Type or edit quote excerpt..."
        android:background="@drawable/bg_search_input"
        android:textColor="?attr/colorOnSurface" />

    <!-- Visual Card Preview to be rendered into Bitmap -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/quoteCardView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:strokeWidth="1dp"
        app:strokeColor="?attr/colorOutline"
        app:cardBackgroundColor="?attr/colorSurfaceVariant">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- Card Header: App Badge & Doc Name -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_launcher" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="DocuQuick"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="12sp"
                    android:textColor="?attr/colorPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" • "
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/txtCardDocTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:singleLine="true"
                    android:ellipsize="middle"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="Physics_Lab_Manual.pdf" />

            </LinearLayout>

            <!-- Card Body: Quotation -->
            <TextView
                android:id="@+id/txtCardQuote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:fontFamily="serif"
                android:textSize="15sp"
                android:lineSpacingMultiplier="1.3"
                android:textColor="?attr/colorOnSurface"
                tools:text="“Life eventually gets better when obstacles become the only correct path”" />

            <!-- Card Footer: Citation -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?attr/colorOutline"
                android:alpha="0.4"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="“Life eventually gets better when obstacles become the only correct path”\n— Abhiroop Ghosh"
                android:textSize="10.5sp"
                android:fontStyle="italic"
                android:textColor="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Dialog Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal"
        android:gravity="end">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCopyQuoteText"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Copy Text" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShareQuoteCard"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Share Image Card"
            app:icon="@drawable/ic_share" />

    </LinearLayout>

</LinearLayout>
