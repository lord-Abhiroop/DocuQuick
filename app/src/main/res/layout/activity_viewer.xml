<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/viewerRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground">

    <!-- Top App Bar & Search Header -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:elevation="2dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/viewerToolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtDocTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="15sp"
                    android:textColor="?attr/colorOnSurface"
                    android:singleLine="true"
                    android:ellipsize="middle"
                    tools:text="Document_Name.pdf" />

                <TextView
                    android:id="@+id/txtDocSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:textSize="11sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="PDF • 1.2 MB" />
            </LinearLayout>

            <!-- Action Buttons -->
            <ImageButton
                android:id="@+id/btnSearch"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_search"
                android:contentDescription="@string/action_search"
                app:tint="?attr/colorOnSurface" />

            <ImageButton
                android:id="@+id/btnTextSize"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_text_size"
                android:contentDescription="@string/action_text_size"
                app:tint="?attr/colorOnSurface" />

            <ImageButton
                android:id="@+id/btnToggleTheme"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_theme"
                android:contentDescription="@string/action_theme_toggle"
                app:tint="?attr/colorOnSurface" />

            <ImageButton
                android:id="@+id/btnShare"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_share"
                android:contentDescription="@string/action_share"
                app:tint="?attr/colorOnSurface" />

        </androidx.appcompat.widget.Toolbar>

        <!-- In-Document Search Panel (Collapsible) -->
        <LinearLayout
            android:id="@+id/searchPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:visibility="gone"
            tools:visibility="visible">

            <EditText
                android:id="@+id/editSearchQuery"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:hint="@string/action_search_hint"
                android:textSize="13sp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/bg_search_input"
                android:imeOptions="actionSearch"
                android:inputType="text" />

            <TextView
                android:id="@+id/txtSearchCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="1/5" />

            <ImageButton
                android:id="@+id/btnSearchPrev"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_back"
                android:rotation="90"
                app:tint="?attr/colorOnSurface" />

            <ImageButton
                android:id="@+id/btnSearchNext"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_back"
                android:rotation="270"
                app:tint="?attr/colorOnSurface" />

            <ImageButton
                android:id="@+id/btnCloseSearch"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_back"
                app:tint="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Main Content Presentation Layers -->
    <FrameLayout
        android:id="@+id/contentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- 1. PDF Renderer Container -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/pdfRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="48dp"
            android:visibility="gone" />

        <!-- 2. Text, DOCX, Markdown, Code Container -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/textScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="16dp"
            android:paddingBottom="64dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/contentTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:textSize="15sp"
                android:lineSpacingMultiplier="1.45"
                android:textColor="?attr/colorOnSurface"
                android:textIsSelectable="true"
                tools:text="This is an example document paragraph." />

        </androidx.core.widget.NestedScrollView>

        <!-- 3. Spreadsheet Container (XLSX, CSV) -->
        <HorizontalScrollView
            android:id="@+id/tableHorizontalScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <ScrollView
                android:id="@+id/tableVerticalScrollView"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:paddingBottom="48dp">

                <TableLayout
                    android:id="@+id/sheetTableLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:stretchColumns="*" />
            </ScrollView>
        </HorizontalScrollView>

        <!-- 4. EPUB E-Book WebView Container -->
        <WebView
            android:id="@+id/epubWebView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- 5. High-Resolution Pinch-to-Zoom ImageView -->
        <ImageView
            android:id="@+id/docImageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <!-- Loading State View -->
        <LinearLayout
            android:id="@+id/loadingLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminate="true" />

            <TextView
                android:id="@+id/txtLoadingStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/loading_document"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- Floating Status / Page Indicator Pill -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/statusPillCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorSurfaceVariant">

            <TextView
                android:id="@+id/txtStatusPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:fontFamily="sans-serif-medium"
                android:textSize="12sp"
                android:textColor="?attr/colorOnSurface"
                tools:text="Page 1 / 18" />

        </com.google.android.material.card.MaterialCardView>

    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
