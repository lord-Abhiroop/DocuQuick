<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/viewerRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground">

    <!-- Top App Bar & Search Header -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:elevation="2dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/viewerToolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtDocTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="15sp"
                    android:textColor="?attr/colorOnSurface"
                    android:singleLine="true"
                    android:ellipsize="middle"
                    tools:text="Document_Name.pdf" />

                <TextView
                    android:id="@+id/txtDocSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:textSize="11sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="PDF • 1.2 MB" />
            </LinearLayout>

            <!-- Action Buttons -->
            <ImageButton
                android:id="@+id/btnSearch"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:padding="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_search"
                android:contentDescription="@string/action_search"
                app:tint="?attr/colorOnSurface" />

            <ImageButton
                android:id="@+id/btnSplitScreen"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:padding="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_split_screen"
                android:contentDescription="Split Screen Compare"
                app:tint="?attr/colorOnSurface" />

            <ImageButton
                android:id="@+id/btnDocTools"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:padding="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_tune"
                android:contentDescription="Document Tools"
                app:tint="?attr/colorOnSurface" />

            <ImageButton
                android:id="@+id/btnReadAloud"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:padding="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_volume_up"
                android:contentDescription="Read Aloud"
                app:tint="?attr/colorOnSurface" />

            <ImageButton
                android:id="@+id/btnPrint"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:padding="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_print"
                android:contentDescription="Print or Save as PDF"
                app:tint="?attr/colorOnSurface" />

            <ImageButton
                android:id="@+id/btnTextSize"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:padding="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_text_size"
                android:contentDescription="@string/action_text_size"
                app:tint="?attr/colorOnSurface" />

            <ImageButton
                android:id="@+id/btnToggleTheme"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:padding="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_theme"
                android:contentDescription="@string/action_theme_toggle"
                app:tint="?attr/colorOnSurface" />

            <ImageButton
                android:id="@+id/btnShare"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:padding="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_share"
                android:contentDescription="@string/action_share"
                app:tint="?attr/colorOnSurface" />

        </androidx.appcompat.widget.Toolbar>

        <!-- In-Document Search Panel (Collapsible) -->
        <LinearLayout
            android:id="@+id/searchPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:visibility="gone"
            tools:visibility="visible">

            <EditText
                android:id="@+id/editSearchQuery"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:hint="@string/action_search_hint"
                android:textSize="13sp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/bg_search_input"
                android:imeOptions="actionSearch"
                android:inputType="text" />

            <TextView
                android:id="@+id/txtSearchCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="1/5" />

            <ImageButton
                android:id="@+id/btnSearchPrev"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_back"
                android:rotation="90"
                app:tint="?attr/colorOnSurface" />

            <ImageButton
                android:id="@+id/btnSearchNext"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_back"
                android:rotation="270"
                app:tint="?attr/colorOnSurface" />

            <ImageButton
                android:id="@+id/btnCloseSearch"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_back"
                app:tint="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Main Split-Screen Container -->
    <LinearLayout
        android:id="@+id/splitMainContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Primary Document Pane (Takes 100% when split is off, 50% when split is on) -->
        <FrameLayout
            android:id="@+id/primaryPaneContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.docuquick.app.ui.ZoomableLayout
                android:id="@+id/contentContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

        <!-- 1. PDF Renderer Container -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/pdfRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="48dp"
            android:visibility="gone" />

        <!-- 2. Text, DOCX, Markdown, Code Container -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/textScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="16dp"
            android:paddingBottom="64dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/contentTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:textSize="15sp"
                android:lineSpacingMultiplier="1.45"
                android:textColor="?attr/colorOnSurface"
                android:textIsSelectable="true"
                tools:text="This is an example document paragraph." />

        </androidx.core.widget.NestedScrollView>

        <!-- 3. Spreadsheet Container (XLSX, CSV) -->
        <HorizontalScrollView
            android:id="@+id/tableHorizontalScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <ScrollView
                android:id="@+id/tableVerticalScrollView"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:paddingBottom="48dp">

                <TableLayout
                    android:id="@+id/sheetTableLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:stretchColumns="*" />
            </ScrollView>
        </HorizontalScrollView>

        <!-- 4. EPUB E-Book WebView Container -->
        <WebView
            android:id="@+id/epubWebView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- 5. High-Resolution Pinch-to-Zoom ImageView -->
        <ImageView
            android:id="@+id/docImageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <!-- Loading State View -->
        <LinearLayout
            android:id="@+id/loadingLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminate="true" />

            <TextView
                android:id="@+id/txtLoadingStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/loading_document"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- Clean Unsupported File / Error State Container -->
        <LinearLayout
            android:id="@+id/errorStateLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/imgErrorIcon"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_alert_unsupported" />

            <TextView
                android:id="@+id/txtErrorTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Unsupported File"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/txtErrorMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="DocuQuick is designed for documents (PDF, Word, Excel, Text, Markdown, EPUB, Code, and Images)."
                android:textSize="13sp"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal"
                android:gravity="center">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnErrorGoBack"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Go Back"
                    android:layout_marginEnd="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnErrorOpenWith"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Open in Other App" />

            </LinearLayout>

        </LinearLayout>

        <!-- Floating Status / Page Indicator Pill (Tap to Jump) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/statusPillCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="16dp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            android:foreground="?attr/selectableItemBackground"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorSurfaceVariant">

            <TextView
                android:id="@+id/txtStatusPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:fontFamily="sans-serif-medium"
                android:textSize="12sp"
                android:textColor="?attr/colorOnSurface"
                tools:text="Page 1 / 18" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Floating Zoom Level Pill (Tap to Reset Zoom) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/zoomPillCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorSurfaceVariant">

            <TextView
                android:id="@+id/txtZoomPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:fontFamily="sans-serif-medium"
                android:textSize="11sp"
                android:textColor="?attr/colorPrimary"
                tools:text="150% ⤢ Reset" />

        </com.google.android.material.card.MaterialCardView>

            </com.docuquick.app.ui.ZoomableLayout>

        </FrameLayout>

        <!-- Split Divider Bar (Visible only during split mode) -->
        <LinearLayout
            android:id="@+id/splitDividerLayout"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="6dp"
            android:background="?attr/colorSurfaceVariant"
            android:elevation="4dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtSplitSecondDocTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:textSize="12sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:singleLine="true"
                android:ellipsize="middle"
                android:text="Compare Document" />

            <ImageButton
                android:id="@+id/btnSplitSyncScroll"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_link"
                android:contentDescription="Synchronize Scroll"
                app:tint="?attr/colorOnSurfaceVariant" />

            <ImageButton
                android:id="@+id/btnSplitSwap"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_swap_vert"
                android:contentDescription="Swap Panes"
                app:tint="?attr/colorOnSurfaceVariant" />

            <ImageButton
                android:id="@+id/btnSplitChangeDoc"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_folder_open"
                android:contentDescription="Choose Document"
                app:tint="?attr/colorOnSurfaceVariant" />

            <ImageButton
                android:id="@+id/btnSplitClose"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close"
                android:contentDescription="Close Split Screen"
                app:tint="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

        <!-- Secondary Document Pane (Visible only during split mode) -->
        <FrameLayout
            android:id="@+id/secondaryPaneContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone">

            <!-- Empty / Selection View for Secondary Pane -->
            <LinearLayout
                android:id="@+id/splitEmptyLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="20dp"
                android:background="?android:attr/windowBackground">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/ic_split_screen"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Choose Document to Compare"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="15sp"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Select from recent documents or browse storage"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <!-- Recents List for Quick Selection -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/splitRecentsRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:maxHeight="150dp"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSplitBrowse"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Browse Files"
                    app:icon="@drawable/ic_folder_open" />

            </LinearLayout>

            <!-- Active Content View for Secondary Pane -->
            <com.docuquick.app.ui.ZoomableLayout
                android:id="@+id/splitContentContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/splitPdfRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingTop="4dp"
                    android:paddingBottom="24dp"
                    android:visibility="gone" />

                <androidx.core.widget.NestedScrollView
                    android:id="@+id/splitTextScrollView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:fillViewport="true"
                    android:padding="16dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/splitContentTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:textSize="14sp"
                        android:lineSpacingMultiplier="1.4"
                        android:textColor="?attr/colorOnSurface"
                        android:textIsSelectable="true" />
                </androidx.core.widget.NestedScrollView>

                <WebView
                    android:id="@+id/splitEpubWebView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/splitDocImageView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/splitProgressBar"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:visibility="gone" />

            </com.docuquick.app.ui.ZoomableLayout>

        </FrameLayout>

    </LinearLayout>

    <!-- Privacy Peep Shield Overlay -->
    <FrameLayout
        android:id="@+id/peepShieldContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="?attr/actionBarSize"
        android:visibility="gone">

        <com.docuquick.app.ui.PrivacyPeepShieldView
            android:id="@+id/privacyPeepShield"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Floating Peep Controls -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="?attr/colorSurfaceVariant">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/btnPeepShrink"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:gravity="center"
                    android:text="−"
                    android:textSize="18sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:background="?attr/selectableItemBackgroundBorderless" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Slit"
                    android:textSize="11sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp" />

                <TextView
                    android:id="@+id/btnPeepExpand"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:gravity="center"
                    android:text="+"
                    android:textSize="18sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:background="?attr/selectableItemBackgroundBorderless" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="18dp"
                    android:background="?attr/colorOutline"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp" />

                <ImageButton
                    android:id="@+id/btnPeepClose"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_close"
                    app:tint="?attr/colorOnSurfaceVariant"
                    android:contentDescription="Close Peep Shield" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </FrameLayout>

    <!-- Auto-Scroll Floating Control Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/autoScrollCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:visibility="gone"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="?attr/colorSurfaceVariant">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageButton
                android:id="@+id/btnAutoScrollPlayPause"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_pause"
                android:contentDescription="Play/Pause"
                app:tint="?attr/colorPrimary" />

            <TextView
                android:id="@+id/txtAutoScrollSpeed"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="1.0x"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <View
                android:layout_width="1dp"
                android:layout_height="20dp"
                android:background="?attr/colorOutline"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="6dp" />

            <ImageButton
                android:id="@+id/btnAutoScrollClose"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close"
                android:contentDescription="Stop Auto Scroll"
                app:tint="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
